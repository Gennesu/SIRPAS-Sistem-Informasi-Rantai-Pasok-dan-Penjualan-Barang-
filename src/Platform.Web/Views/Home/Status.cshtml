@{
    ViewData["Title"] = "Pemberitahuan";
    var signedIn = User.Identity?.IsAuthenticated == true;
}
@if (!signedIn)
{
    <div class="auth-panel" style="min-height:100vh">
        <div class="card auth-card center">
            <div class="empty"><div class="e-ico">@UiIcons.Svg("triangle-alert", 30)</div><h3>@ViewData["Heading"]</h3><p>@ViewData["Message"]</p><a class="btn" asp-controller="Home" asp-action="Index">Kembali ke beranda</a></div>
        </div>
    </div>
}
else
{
    <div class="card mt-3" style="max-width:560px;margin-inline:auto">
        <div class="empty"><div class="e-ico">@UiIcons.Svg("triangle-alert", 30)</div><h3>@ViewData["Heading"]</h3><p>@ViewData["Message"]</p><a class="btn" asp-controller="Home" asp-action="Index">Kembali ke beranda</a></div>
    </div>
}
