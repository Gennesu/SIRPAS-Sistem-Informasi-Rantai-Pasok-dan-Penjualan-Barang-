@model ValueTuple<string, string>
@{
    var (field, label) = Model;
}
<button type="button" class="password-toggle" data-password-toggle="@label"
        aria-controls="@Html.Id(field)" aria-label="Tampilkan @label" hidden>
    @UiIcons.Svg("eye", 20, "password-icon-show")
    @UiIcons.Svg("eye-off", 20, "password-icon-hide")
</button>
