@using Platform.Web.Modules.Stock.Contracts
@model IReadOnlyList<MovementDto>
@{
    ViewData["Title"] = "Riwayat pergerakan stok";
    ViewData["Nav"] = "Stock/Index";
}

<div class="crumbs">
    <a asp-controller="Stock" asp-action="Index">Stok</a>
    @UiIcons.Svg("chevron-right", 14)
    <span>Riwayat pergerakan</span>
</div>

<div class="page-head">
    <div>
        <h1>Riwayat pergerakan stok</h1>
        <p class="lead">
            100 pergerakan terakhir. Setiap perubahan stok selalu punya catatan di sini,
            termasuk barang kadaluarsa yang dibuang.
        </p>
    </div>

    <div class="page-actions">
        <a class="btn btn-secondary" asp-controller="Stock" asp-action="Index">
            @UiIcons.Svg("arrow-left", 18) Kembali ke stok
        </a>
    </div>
</div>

<div class="card pad-0">
    <div class="table-wrap">
        <table class="table table-stack hover">
            <thead>
                <tr>
                    <th>Waktu (WIB)</th>
                    <th>Produk</th>
                    <th>Jenis</th>
                    <th class="right">Jumlah</th>
                    <th class="right">Modal / item</th>
                    <th class="right">Saldo</th>
                    <th>Keterangan</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var m in Model)
                {
                    <tr>
                        <td class="cell-title">
                            <span class="name">@WibTime.FormatDateTime(m.At)</span>
                        </td>

                        <td data-label="Produk">@m.ProductName</td>

                        <td data-label="Jenis">
                            <span class="badge @(m.TypeLabel.Contains("adaluarsa") ? "badge-danger" : "")">
                                @m.TypeLabel
                            </span>
                        </td>

                        <td class="right" data-label="Jumlah">
                            <span class="badge @(m.QtyBaseSigned >= 0 ? "badge-ok" : "badge-warn") num">
                                @(m.QtyBaseSigned >= 0 ? "+" : "")@m.QtyBaseSigned
                            </span>
                        </td>

                        <td class="right num" data-label="Modal / item">
                            @Rupiah.Format(m.UnitCost, 2)
                        </td>

                        <td class="right num" data-label="Saldo">
                            @m.BalanceAfter
                        </td>

                        <td data-label="Keterangan" class="muted small">
                            @m.Reason
                        </td>
                    </tr>
                }

                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="muted">
                            Belum ada pergerakan stok.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>