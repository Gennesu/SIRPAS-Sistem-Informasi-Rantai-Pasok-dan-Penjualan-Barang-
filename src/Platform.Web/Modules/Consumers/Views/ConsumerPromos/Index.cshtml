@model IReadOnlyList<Platform.Web.Modules.Consumers.Contracts.PromoSettingDto>
@{ ViewData["Title"] = "Promo untuk pembeli"; ViewData["Nav"] = "ConsumerPromos/Index"; }
<div class="page-head"><div><h1>Promo untuk pembeli</h1>
    <p class="lead">Unit dari batch yang kedaluwarsa dalam N hari dijual dengan diskon kepada pembeli akhir dan terjual lebih dulu (FEFO). Produk yang sudah kedaluwarsa tidak pernah ditawarkan. Gunakan ini agar stok tidak terbuang.</p></div></div>
@if (Model.Count == 0)
{
    <div class="card empty"><h3>Belum ada stok</h3><p class="muted">Tambahkan stok bertanggal kedaluwarsa dulu di menu Stok.</p></div>
}
else
{
    <div class="card pad-0"><div class="table-wrap"><table class="table table-stack hover">
        <thead><tr><th>Produk</th><th class="right">Harga</th><th class="right">Tersedia</th><th class="right">Hampir kedaluwarsa</th><th>Promo</th></tr></thead>
        <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td data-label="Produk" class="cell-title">
                    <div class="pcell">
                        <partial name="_ProductThumb" model="new ProductThumbModel(p.ImagePath, p.ProductName, 48)" />
                        <div class="grow"><b>@p.ProductName</b></div>
                    </div>
                </td>
                <td data-label="Harga" class="right num">@Rupiah.Format(p.RegularPrice)</td>
                <td data-label="Tersedia" class="right num">@p.AvailableQty @p.BaseUnitName</td>
                <td data-label="Hampir kedaluwarsa" class="right num">@p.NearExpiryQty @p.BaseUnitName</td>
                <td data-label="Promo">
                    <form asp-action="Save" method="post" class="row" style="gap:8px;flex-wrap:wrap">
                        <input type="hidden" name="productId" value="@p.ProductId" />
                        <input type="number" name="discountPercent" min="5" max="90" value="@p.DiscountPercent" placeholder="% diskon" style="width:92px" aria-label="Diskon persen @p.ProductName" />
                        <input type="number" name="withinDays" min="1" max="90" value="@(p.WithinDays ?? 7)" style="width:92px" aria-label="Hari menuju kedaluwarsa @p.ProductName" /> <span class="muted small">hari</span>
                        <button class="btn btn-sm" type="submit">Simpan</button>
                        @if (p.DiscountPercent is not null) { <button class="btn btn-sm btn-secondary" type="submit" name="remove" value="true">Hapus</button> }
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table></div></div>
}
